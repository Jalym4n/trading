# Market data — never commit (licensed, large, not redistributable)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.csv
*.csv.zst
*.zst
*.parquet

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# Results — regenerable, keep repo clean (comment out if you want them tracked)
results/*
!results/.gitkeep
# the trial counter and the holdout ledger are evidence, not regenerable: tracked
!results/trial_log.jsonl
!results/holdout_ledger.jsonl

# OS / editor
.DS_Store
.vscode/
.idea/
