//@version=6
// Accumulation / Manipulation / Distribution (Power of 3), self-scoring
//
// WHAT IS DETECTED LIVE (no hindsight):
//   1. CONSOLIDATION  the first N bars of the session form a range that is
//                     narrow relative to ATR
//   2. MANIPULATION   price breaks beyond that range by a threshold, then
//                     CLOSES back inside within a few bars
//
// WHAT IS NOT DETECTED, ONLY MEASURED:
//   3. DISTRIBUTION   the claim that price then runs in the OPPOSITE
//                     direction to the break. That is the prediction, so
//                     labelling it would be circular. Instead the indicator
//                     waits evalBars and tallies the outcome.
//
// The scoreboard counts moves in the PREDICTED direction and in the
// OPPOSITE direction. Those two numbers are the whole point. If they are
// close to equal, the pattern carries no directional information here.

indicator("AMD / Power of 3 (self-scoring)", overlay = true,
     max_boxes_count = 200, max_labels_count = 200)

// ---------------------------------------------------------------- inputs --
consBars    = input.int(6,    "Consolidation bars", minval = 2,
     tooltip = "Bars defining the opening range. 6 = 30 min on a 5m chart.")
maxRangeAtr = input.float(1.5, "Max range (x ATR)", minval = 0.1, step = 0.1,
     tooltip = "Range must be no wider than this to count as consolidation.")
minBreakAtr = input.float(0.25, "Min break beyond range (x ATR)", minval = 0.0, step = 0.05)
reclaimBars = input.int(3,    "Reclaim within N bars", minval = 1,
     tooltip = "Price must close back inside the range within this many bars.")
evalBars    = input.int(24,   "Score after N bars", minval = 1)
hitAtr      = input.float(0.5, "Counts as a move: (x ATR)", minval = 0.1, step = 0.1)
showBoxes   = input.bool(true, "Draw range boxes")

atrPrev = ta.sma(ta.tr(true), 14)[1]
atrOk   = not na(atrPrev) and atrPrev > 0

// ---------------------------------------------------------------- state ---
var int   k        = 0      // bar index within session
var float rHi      = na
var float rLo      = na
var bool  isCons   = false
var box   rangeBox = na

var bool  armed    = false  // broke out, waiting to see if it reclaims
var int   brkDir   = 0
var int   brkBar   = na
var bool  usedUp   = false  // one manipulation per session

// pending score, deliberately NOT reset at the session boundary
var int   pDir     = 0      // break direction; prediction is the opposite
var int   pBar     = na
var float pPrice   = na

var int nSetups = 0
var int nPred   = 0         // moved hitAtr in the PREDICTED direction
var int nOpp    = 0         // moved hitAtr in the OPPOSITE direction
var int nFlat   = 0         // moved less than hitAtr either way

k := session.isfirstbar_regular ? 0 : k + 1

if session.isfirstbar_regular
    rHi    := high
    rLo    := low
    isCons := false
    armed  := false
    brkDir := 0
    usedUp := false
else if k < consBars
    rHi := math.max(rHi, high)
    rLo := math.min(rLo, low)

// ------------------------------------------------- phase 1: consolidation --
if k == consBars and atrOk
    isCons := (rHi - rLo) <= maxRangeAtr * atrPrev
    if showBoxes
        rangeBox := box.new(bar_index - consBars, rHi, bar_index, rLo,
             border_color = color.new(isCons ? #1D9E75 : color.gray, 40),
             border_width = 1,
             bgcolor = color.new(isCons ? #1D9E75 : color.gray, isCons ? 85 : 92))

// -------------------------------------------------- phase 2: manipulation --
manipFired = false
if isCons and atrOk and not usedUp and k > consBars
    if not armed
        if high > rHi + minBreakAtr * atrPrev
            armed  := true
            brkDir := 1
            brkBar := bar_index
        else if low < rLo - minBreakAtr * atrPrev
            armed  := true
            brkDir := -1
            brkBar := bar_index
    else
        if bar_index - brkBar > reclaimBars
            armed := false          // never came back: a real breakout, not a fake
        else
            reclaimed = brkDir == 1 ? close < rHi : close > rLo
            if reclaimed
                armed      := false
                usedUp     := true
                manipFired := true
                nSetups    := nSetups + 1
                pDir       := brkDir
                pBar       := bar_index
                pPrice     := close

if manipFired
    expectUp = pDir == -1
    label.new(bar_index, expectUp ? low : high,
         text  = expectUp ? "AMD ▲" : "AMD ▼",
         style = expectUp ? label.style_label_up : label.style_label_down,
         color = color.new(expectUp ? #1D9E75 : #D85A30, 25),
         textcolor = color.white, size = size.tiny)

// ----------------------------------------------------- phase 3: scoring ----
// Fires exactly once, evalBars after the setup. Counts BOTH directions so the
// predicted tally has a control to be compared against.
if pDir != 0 and not na(pBar) and bar_index - pBar == evalBars and atrOk
    expected = -pDir
    move     = (close - pPrice) * expected
    thresh   = hitAtr * atrPrev
    if move >= thresh
        nPred := nPred + 1
    else if move <= -thresh
        nOpp := nOpp + 1
    else
        nFlat := nFlat + 1

// --------------------------------------------------------- scoreboard -----
var table tbl = table.new(position.top_right, 2, 5,
     bgcolor = color.new(color.gray, 82), border_width = 1)

f_cell(c, r, txt) =>
    table.cell(tbl, c, r, txt, text_size = size.small, text_color = chart.fg_color)

if barstate.islast
    scored = nPred + nOpp + nFlat
    rate   = scored > 0 ? nPred / scored : 0.0
    oppR   = scored > 0 ? nOpp  / scored : 0.0
    f_cell(0, 0, "setups")
    f_cell(1, 0, str.tostring(nSetups))
    f_cell(0, 1, "scored")
    f_cell(1, 1, str.tostring(scored))
    f_cell(0, 2, "predicted dir")
    f_cell(1, 2, str.tostring(nPred) + "  (" + str.tostring(rate * 100, "#.0") + "%)")
    f_cell(0, 3, "opposite dir")
    f_cell(1, 3, str.tostring(nOpp) + "  (" + str.tostring(oppR * 100, "#.0") + "%)")
    f_cell(0, 4, "neither")
    f_cell(1, 4, str.tostring(nFlat))

alertcondition(manipFired, "AMD manipulation", "Range break reclaimed, distribution expected opposite")
