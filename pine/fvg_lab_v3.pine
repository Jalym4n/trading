//@version=6
// Fair Value Gap + inversion (iFVG) — mirrors fvg_lab/strategy.py v3
//
// New in v3:
//   * invalidationMode: "wick" or "close" — what counts as trading through
//   * invertOnViolation: a failed zone keeps its boundaries and flips
//     polarity (iFVG). Bullish support that fails becomes bearish resistance.
//   * counter splits fvg vs ifvg so you can see the mix

indicator("FVG + iFVG (fvg_lab) v3", overlay = true, max_boxes_count = 500)

// ---------------------------------------------------------------- inputs --
minGapAtr  = input.float(0.0, "Min gap (x ATR)", minval = 0.0, step = 0.05,
     tooltip = "Params.min_gap_atr")
fvgMaxAge  = input.int(20, "Max age (bars)", minval = 1, tooltip = "Params.fvg_max_age")
atrPeriod  = input.int(14, "ATR period", minval = 1, tooltip = "Params.atr_period")
invMode    = input.string("wick", "Invalidation", options = ["wick", "close"],
     tooltip = "Params.invalidation_mode. wick = bar's extreme pierced the far edge. close = the bar had to settle beyond it.")
doInvert   = input.bool(true, "Invert on violation (iFVG)",
     tooltip = "Params.invert_on_violation")
maxFlips   = input.int(1, "Max inversions per zone", minval = 0,
     tooltip = "Params.max_inversions")
keepDead   = input.bool(true, "Keep retired zones (dimmed)")
showStats  = input.bool(true, "Show counter")

bullFill = input.color(color.new(#1D9E75, 70), "Bullish FVG")
bearFill = input.color(color.new(#D85A30, 70), "Bearish FVG")
ibullCol = input.color(color.new(#7F77DD, 62), "Inverted → bullish")
ibearCol = input.color(color.new(#D4537E, 62), "Inverted → bearish")
deadFill = input.color(color.new(color.gray, 88), "Retired")

// ------------------------------------------------------------------ ATR ---
// Simple mean of true range, shifted one bar, matching
// tr.rolling(n).mean().shift(1) in precompute(). Not ta.atr(), which uses
// Wilder smoothing and would place the size threshold differently.
atrPrev = ta.sma(ta.tr(true), atrPeriod)[1]
valid   = not na(atrPrev) and atrPrev > 0
thresh  = minGapAtr * nz(atrPrev)

// ---------------------------------------------------------------- state ---
var array<box>  zones  = array.new<box>()
var array<int>  dirs   = array.new<int>()
var array<int>  births = array.new<int>()
var array<int>  flips  = array.new<int>()
var array<bool> alive  = array.new<bool>()
var int nFvg  = 0
var int nIfvg = 0

// ------------------------------------------------------------ detection ---
bullGap = valid and low  > high[2] and (low - high[2]) >= thresh
bearGap = valid and high < low[2]  and (low[2] - high) >= thresh

if bullGap
    nFvg += 1
    array.push(zones, box.new(bar_index - 2, low, bar_index, high[2],
         border_color = color.new(#1D9E75, 30), border_width = 1, bgcolor = bullFill))
    array.push(dirs, 1)
    array.push(births, bar_index)
    array.push(flips, 0)
    array.push(alive, true)

if bearGap
    nFvg += 1
    array.push(zones, box.new(bar_index - 2, low[2], bar_index, high,
         border_color = color.new(#D85A30, 30), border_width = 1, bgcolor = bearFill))
    array.push(dirs, -1)
    array.push(births, bar_index)
    array.push(flips, 0)
    array.push(alive, true)

// ---------------------------------------------------------- maintenance ---
probeDn = invMode == "wick" ? low  : close
probeUp = invMode == "wick" ? high : close

nLive = 0
if array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        if array.get(alive, i)
            zx  = array.get(zones, i)
            d   = array.get(dirs, i)
            f   = array.get(flips, i)
            age = bar_index - array.get(births, i)
            top = box.get_top(zx)
            bot = box.get_bottom(zx)

            expired  = age > fvgMaxAge
            violated = d == 1 ? probeDn < bot : probeUp > top

            if expired
                array.set(alive, i, false)
                if keepDead
                    box.set_bgcolor(zx, deadFill)
                    box.set_border_color(zx, na)
                else
                    box.delete(zx)
            else if violated
                if doInvert and f < maxFlips
                    // iFVG: same boundaries, opposite polarity, clock reset
                    nIfvg += 1
                    array.set(dirs, i, -d)
                    array.set(flips, i, f + 1)
                    array.set(births, i, bar_index)
                    box.set_bgcolor(zx, -d == 1 ? ibullCol : ibearCol)
                    box.set_border_color(zx, color.new(-d == 1 ? #7F77DD : #D4537E, 25))
                    box.set_right(zx, bar_index)
                    nLive += 1
                else
                    array.set(alive, i, false)
                    if keepDead
                        box.set_bgcolor(zx, deadFill)
                        box.set_border_color(zx, na)
                    else
                        box.delete(zx)
            else
                box.set_right(zx, bar_index)
                nLive += 1

// ----------------------------------------------------------- diagnostic ---
var table tbl = table.new(position.top_right, 2, 3,
     bgcolor = color.new(color.gray, 82), border_width = 1)
if showStats and barstate.islast
    table.cell(tbl, 0, 0, "FVGs formed", text_size = size.small, text_color = chart.fg_color)
    table.cell(tbl, 1, 0, str.tostring(nFvg), text_size = size.small, text_color = chart.fg_color)
    table.cell(tbl, 0, 1, "inversions", text_size = size.small, text_color = chart.fg_color)
    table.cell(tbl, 1, 1, str.tostring(nIfvg), text_size = size.small, text_color = chart.fg_color)
    table.cell(tbl, 0, 2, "live now", text_size = size.small, text_color = chart.fg_color)
    table.cell(tbl, 1, 2, str.tostring(nLive), text_size = size.small, text_color = chart.fg_color)

alertcondition(bullGap, "Bullish FVG", "Bullish fair value gap formed")
alertcondition(bearGap, "Bearish FVG", "Bearish fair value gap formed")
