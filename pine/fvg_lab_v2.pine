//@version=6
// Fair Value Gap — mirrors fvg_lab/strategy.py  (v2, diagnostic build)
//
// Differences from v1:
//   * invalidated gaps stay on the chart, dimmed, instead of vanishing
//   * visible borders and less transparency
//   * a counter in the top-right so you can tell "not detecting" apart from
//     "detecting but not visible"
//   * min gap defaults to 0 so nothing is filtered out on first look

indicator("FVG (fvg_lab) v2", overlay = true, max_boxes_count = 500)

// ---------------------------------------------------------------- inputs --
minGapAtr = input.float(0.0, "Min gap (x ATR)", minval = 0.0, step = 0.05,
     tooltip = "Params.min_gap_atr. Start at 0, raise until the chart is readable.")
fvgMaxAge = input.int(20, "Max age (bars)", minval = 1, tooltip = "Params.fvg_max_age")
atrPeriod = input.int(14, "ATR period", minval = 1, tooltip = "Params.atr_period")
keepDead  = input.bool(true, "Keep invalidated gaps (dimmed)")
showStats = input.bool(true, "Show diagnostic counter")

bullFill = input.color(color.new(#1D9E75, 70), "Bullish fill")
bearFill = input.color(color.new(#D85A30, 70), "Bearish fill")
deadFill = input.color(color.new(color.gray, 88), "Invalidated fill")

// ------------------------------------------------------------------ ATR ---
// Simple mean of true range, shifted one bar, matching
// tr.rolling(n).mean().shift(1) in precompute(). Not ta.atr(), which uses
// Wilder smoothing and would place the threshold slightly differently.
atrPrev = ta.sma(ta.tr(true), atrPeriod)[1]
valid   = not na(atrPrev) and atrPrev > 0
thresh  = minGapAtr * nz(atrPrev)

// ---------------------------------------------------------------- state ---
var array<box>  zones  = array.new<box>()
var array<int>  dirs   = array.new<int>()
var array<int>  births = array.new<int>()
var array<bool> alive  = array.new<bool>()
var int nBull = 0
var int nBear = 0

// ------------------------------------------------------------ detection ---
// 3-bar imbalance, known only at the CLOSE of the current bar.
bullGap = valid and low  > high[2] and (low - high[2]) >= thresh
bearGap = valid and high < low[2]  and (low[2] - high) >= thresh

if bullGap
    nBull += 1
    array.push(zones, box.new(bar_index - 2, low, bar_index, high[2],
         border_color = color.new(#1D9E75, 30), border_width = 1, bgcolor = bullFill))
    array.push(dirs, 1)
    array.push(births, bar_index)
    array.push(alive, true)

if bearGap
    nBear += 1
    array.push(zones, box.new(bar_index - 2, low[2], bar_index, high,
         border_color = color.new(#D85A30, 30), border_width = 1, bgcolor = bearFill))
    array.push(dirs, -1)
    array.push(births, bar_index)
    array.push(alive, true)

// ---------------------------------------------------------- maintenance ---
// Only living zones are touched, so boxes TradingView has already culled past
// max_boxes_count are never referenced again.
nLive = 0
if array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        if array.get(alive, i)
            zx   = array.get(zones, i)
            d    = array.get(dirs, i)
            age  = bar_index - array.get(births, i)
            dead = age > fvgMaxAge or (d == 1 ? low < box.get_bottom(zx) : high > box.get_top(zx))
            if dead
                array.set(alive, i, false)
                if keepDead
                    box.set_bgcolor(zx, deadFill)
                    box.set_border_color(zx, na)
                else
                    box.delete(zx)
            else
                box.set_right(zx, bar_index)
                nLive += 1

// ----------------------------------------------------------- diagnostic ---
// If these counts are > 0 but you see nothing, it is a rendering problem
// (colors, scale, hidden indicator). If they are 0, detection is the issue.
var table tbl = table.new(position.top_right, 2, 3,
     bgcolor = color.new(color.gray, 82), border_width = 1)
if showStats and barstate.islast
    table.cell(tbl, 0, 0, "bullish found", text_size = size.small, text_color = chart.fg_color)
    table.cell(tbl, 1, 0, str.tostring(nBull), text_size = size.small, text_color = chart.fg_color)
    table.cell(tbl, 0, 1, "bearish found", text_size = size.small, text_color = chart.fg_color)
    table.cell(tbl, 1, 1, str.tostring(nBear), text_size = size.small, text_color = chart.fg_color)
    table.cell(tbl, 0, 2, "live now", text_size = size.small, text_color = chart.fg_color)
    table.cell(tbl, 1, 2, str.tostring(nLive), text_size = size.small, text_color = chart.fg_color)

alertcondition(bullGap, "Bullish FVG", "Bullish fair value gap formed")
alertcondition(bearGap, "Bearish FVG", "Bearish fair value gap formed")
